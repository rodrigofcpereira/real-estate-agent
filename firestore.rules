rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Usuários ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null
                  && request.auth.uid == userId;
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasAny(['expiresAt', 'storageLimit']);
      allow create, delete: if false;
    }

    // ── Clientes ──────────────────────────────────────────────────────────────
    match /clientes/{clienteId} {
      allow read, write: if request.auth != null;
    }

    // ── Propriedades ──────────────────────────────────────────────────────────
    // Leitura pública: clientes recebem link via WhatsApp e acessam sem login.
    match /propriedades/{propriedadeId} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // ── Transmissões (fila de trabalho persistente de disparos) ──────────────
    // O usuário pode criar, ler, e atualizar suas próprias transmissões.
    // Cada transmissão guarda o status de cada destinatário (pendente/enviado/erro)
    // para poder retomar de onde parou se o app fechar ou a internet cair.
    match /transmissoes/{transmissaoId} {
      allow create: if request.auth != null;
      allow read:   if request.auth != null
                    && resource.data.usuarioUid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.usuarioUid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.usuarioUid == request.auth.uid;
    }

    // ── Diagnósticos (telemetria de erros para debug remoto) ────────────────────
    // O app grava aqui automaticamente quando algo dá errado (número não
    // encontrado, timeout, falha de envio, desconexão, etc). Só permite criar
    // (nunca ler/editar/apagar pelo app) — a visualização é feita direto no
    // Firebase Console, que como owner do projeto ignora estas regras.
    match /diagnosticos/{docId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // ── Negar tudo o mais ─────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
